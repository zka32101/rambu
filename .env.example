# 乱舞将棋 デプロイ環境変数テンプレート
# 使用方法: cp .env.example .env して値を設定

# Firebase 認証
FIREBASE_PROJECT_ID=rambusgame-prod
FIREBASE_API_KEY=your_firebase_api_key_here

# Google Play Console 認証
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json
GOOGLE_PLAY_PACKAGE_NAME=com.rambusgame.shogi

# App Store Connect 認証（iOS の場合）
APPSTORE_CONNECT_KEY_ID=your_key_id
APPSTORE_CONNECT_ISSUER_ID=your_issuer_id
APPSTORE_CONNECT_PRIVATE_KEY_PATH=/path/to/private_key.p8

# Android キーストア
KEYSTORE_PASSWORD=your_keystore_password_here
KEY_PASSWORD=your_key_password_here
KEYSTORE_PATH=~/.android_keys/rambu_shogi.keystore

# Slack 通知（オプション）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ビルド設定
BUILD_VERSION=1.0.0
BUILD_NUMBER=1
FLUTTER_VERSION=3.13.x

# デプロイターゲット
DEPLOY_TARGET=production  # internal, beta, production
FIRESTORE_DATABASE=rambusgame-prod

# オプション
DEBUG=false
VERBOSE=false
DRY_RUN=false
