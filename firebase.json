{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "*-debug.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "bucket": "rambu-highlights",
      "rules": "storage.rules",
      "ignore": [
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ]
}
